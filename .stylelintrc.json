{
  "extends": "stylelint-config-standard",
  "plugins": ["@stylistic/stylelint-plugin", "./stylelint-rules/no-eof-blank-line.mjs"],
  "rules": {
    "custom-property-pattern": null,
    "keyframes-name-pattern": null,
    "no-descending-specificity": null,
    "font-family-no-missing-generic-family-keyword": null,
    "import-notation": null,

    "selector-class-pattern": [
      "^(v-|mapboxgl-)[a-z0-9-]+$|^[a-z][a-z0-9]*(_[a-z0-9]+)*(__[a-z][a-z0-9]*(_[a-z0-9]+)*)?(--[a-z][a-z0-9]*(_[a-z0-9]+)*)?$|^[a-z0-9_]+-(enter|leave)-(active|from|to)$",
      {
        "message": "Class must be strict BEM: block(_word)*, optional __element(_word)*, optional --modifier(_word)* (e.g. 'card__title--active'), a 'v-*' (Vue) or 'mapboxgl-*' (Mapbox GL) library class, or a Vue transition class (e.g. 'fade-enter-active')."
      }
    ],

    "declaration-no-important": true,
    "property-disallowed-list": ["float"],
    "property-no-vendor-prefix": true,
    "value-no-vendor-prefix": true,

    "selector-max-compound-selectors": 3,
    "selector-max-combinators": 2,

    "declaration-property-value-no-unknown": true,
    "@stylistic/no-eol-whitespace": true,
    "@stylistic/number-leading-zero": "never",
    "local/no-eof-blank-line": true
  }
}
