# Copy to .env (never commit .env). Every value is optional; an empty value
# switches the feature off.

# Public address of the site — used for canonical URLs, hreflang, Open Graph.
NUXT_PUBLIC_SITE_URL=https://zhassulan.netlify.app

# Booking page for the "Book an intro call" button (Cal.com / Calendly link).
# Empty = the button opens a pre-filled email instead.
NUXT_PUBLIC_BOOKING_URL=

# Privacy-friendly analytics (Plausible). Empty = no tracking script at all.
# Set to the domain registered in Plausible, e.g. zhassulan.netlify.app
NUXT_PUBLIC_ANALYTICS_DOMAIN=
# Only change for self-hosted Plausible; if you do, allow the host in
# public/_headers (script-src and connect-src).
NUXT_PUBLIC_ANALYTICS_SCRIPT_SRC=https://plausible.io/js/script.tagged-events.js
