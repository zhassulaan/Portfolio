    "lint:html": "node scripts/lint-html.mjs",
    "lint:unused-css": "python3 scripts/check_unused_css_classes.py",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@nuxtjs/i18n": "^9.0.0",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^3.10.3",
    "pinia": "^4.0.3",
    "vue": "^3.4.19",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.5.0",
    "@nuxt/test-utils": "^3.14.0",
    "@playwright/test": "^1.47.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@vue/test-utils": "^2.4.6",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.9.0",
    "happy-dom": "^15.7.0",
    "html-validate": "^11.15.0",
    "html-validate-vue": "^9.3.1",
    "sass": "^1.71.1",
